# ==============================================================================
# AURA AI — GIT IGNORE RULES
# Prevents sensitive credentials, dependencies, and OS junk from being committed
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
# Ignore all .env files anywhere in the project
.env
.env.*
*.env
*.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# Allow example/template files to be tracked in Git
!.env.example
!backend/.env.example
!frontend/.env.example

# Private certificates and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# 2. Package Dependencies
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
jspm_packages/
.pnp
.pnp.js

# ------------------------------------------------------------------------------
# 3. Logs & Runtime Data
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------------------------------------------
# 4. OS & Filesystem Metadata
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 5. IDEs & Code Editors
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*#
.#*

# ------------------------------------------------------------------------------
# 6. Build Outputs & Temporary Caches
# ------------------------------------------------------------------------------
dist/
build/
out/
.cache/
.temp/
.tmp/
tmp/
temp/
*.tsbuildinfo
