# UI Defaults
VITE_DEFAULT_THEME=dark
VITE_DEFAULT_PERSONA=nexus
VITE_ENABLE_SOUND=true
VITE_ENABLE_SPEECH_RECOGNITION=true
VITE_ENABLE_TEXT_TO_SPEECH=true
